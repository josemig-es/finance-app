# Archivos de entorno y claves privadas
.env
*.pem

# Entornos virtuales y archivos temporales de Python
venv/
__pycache__/

# Base de datos local SQLite
*.db

.venv/

# Local data and secrets (keep the empty folders, ignore their contents)
data/*
!data/.gitkeep
secrets/*
!secrets/.gitkeep

# Extra safety: other secret/key formats and local settings
.env.*
!.env.example
*.key
*.p12
*.pfx
.streamlit/secrets.toml

# Exports of personal data
*.csv
*.xlsx
