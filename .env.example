# Copy this file to ".env" and fill in your real values.
# ".env" is ignored by Git, so your secrets never reach GitHub.

# Path to the SQLite database file
DATABASE_URL=sqlite:///data/finance.db

# Enable Banking (fill in during the "Real bank connection" step)
ENABLE_BANKING_APPLICATION_ID=
ENABLE_BANKING_PRIVATE_KEY_PATH=secrets/your-key.pem
ENABLE_BANKING_REDIRECT_URL=http://localhost:8501
