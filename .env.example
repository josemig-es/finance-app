# Copy this file to ".env" and fill in your values.
# ".env" is ignored by Git, so your secrets never reach GitHub.

# Which data the app uses by default: "real" (your bank) or "sandbox" (test bank)
APP_MODE=sandbox

# Enable Banking — sandbox (test) application
SANDBOX_APP_ID=
SANDBOX_KEY_PATH=secrets/your-sandbox-app-id.pem

# Enable Banking — production (real bank) application
REAL_APP_ID=
REAL_KEY_PATH=secrets/your-real-app-id.pem

# Must match the redirect URL registered in Enable Banking
REDIRECT_URL=https://localhost:8501/
